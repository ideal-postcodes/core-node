{
  "name": "@ideal-postcodes/core-node",
  "version": "4.0.1",
  "description": "Node.js client for api.ideal-postcodes.co.uk",
  "author": {
    "name": "Ideal Postcodes",
    "email": "support@ideal-postcodes.co.uk",
    "url": "https://ideal-postcodes.co.uk"
  },
  "bugs": {
    "url": "https://github.com/ideal-postcodes/core-node/issues",
    "email": "support@ideal-postcodes.co.uk"
  },
  "homepage": "https://github.com/ideal-postcodes/core-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/ideal-postcodes/core-node.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "semantic-release": "semantic-release --no-ci",
    "test:watch": "NODE_ENV=test mocha --watch",
    "test:nock:reload": "NODE_ENV=test RECORD=true mocha",
    "test": "NODE_ENV=test nyc mocha",
    "lint": "eslint lib/**/*.ts",
    "build": "tsc",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "prettier": {
    "trailingComma": "es5"
  },
  "nyc": {
    "include": [
      "lib/**/*.ts",
      "generate/**/*.ts"
    ],
    "exclude": [
      "dist/*",
      "**/*.d.ts",
      "generate/index.ts"
    ],
    "extension": [
      ".ts",
      ".tsx"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": true
  },
  "mocha": {
    "extension": [
      "ts"
    ],
    "exit": true,
    "fullTrace": true,
    "require": [
      "ts-node/register",
      "source-map-support/register"
    ]
  },
  "engines": {
    "node": ">=10.0"
  },
  "keywords": [
    "API",
    "Node.js",
    "UK",
    "Address",
    "Postcode",
    "Search",
    "Ideal Postcodes"
  ],
  "release": {
    "extends": "@cablanchard/semantic-release/dist/npm",
    "branches": [
      "master",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@ideal-postcodes/core-interface": "3.1.0",
    "got": "11.8.6"
  },
  "devDependencies": {
    "@cablanchard/semantic-release": "2.0.0",
    "@cablanchard/tsconfig": "2.0.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "@types/sinon": "22.0.0",
    "chai": "6.2.2",
    "eslint": "10.10.0",
    "keyv": "4.5.4",
    "mocha": "12.0.1",
    "nock": "14.0.17",
    "nyc": "18.0.0",
    "prettier": "3.9.7",
    "semantic-release": "25.0.9",
    "sinon": "22.1.0",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
